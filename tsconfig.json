{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "allowJs": true, // Tells TS to read .js files
    "declaration": true, // Generates the .d.ts files
    "emitDeclarationOnly": true, // Skips generating .js files
    "outDir": "./src", // Places types in a dedicated folder
    "rootDir": "./src",
    //"skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["./src/**/*.js"],
  "exclude": ["./node_modules"]
}
